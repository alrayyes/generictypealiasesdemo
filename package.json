{
  "name": "generictypealiasesdemo",
  "description": "Demo app to test out generic type aliases",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "commit": "cz",
    "markdown:format": "markdownlint-cli2 --fix",
    "markdown:lint": "markdownlint-cli2",
    "prettier:format": "prettier --write",
    "prettier:lint": "prettier --check",
    "biome:format": "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched",
    "biome:lint": "biome check --files-ignore-unknown=true --no-errors-on-unmatched",
    "prepare": "husky"
  },
  "author": "Ryan Kes <ryan@ryankes.eu>",
  "license": "GPL-3.0-only",
  "lint-staged": {
    "**/*": "bun biome:format",
    "**/*.md": "bun prettier:format && bun markdown:format",
    "**/*.{yml,yaml}": "bun prettier:format",
    "**/Dockerfile": "docker compose run --rm hadolint hadolint",
    ".husky/commit-msg": "docker compose run --rm shellcheck -x",
    ".husky/pre-commit": "docker compose run --rm shellcheck -x",
    ".husky/pre-push": "docker compose run --rm shellcheck -x"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
